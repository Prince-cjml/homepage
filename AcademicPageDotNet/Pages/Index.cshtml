@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<section class="profile @(string.IsNullOrWhiteSpace(Model.Personal.GetValueOrDefault("AvatarUrl")) ? "profile-no-image" : "")" aria-labelledby="profile-name">
    @if (!string.IsNullOrWhiteSpace(Model.Personal.GetValueOrDefault("AvatarUrl")))
    {
        <div class="portrait-frame">
            <img class="portrait" src="@Model.Personal["AvatarUrl"]" asp-append-version="true" alt="Portrait of @Model.Personal["Name"]" width="640" height="720" />
        </div>
    }
    <div class="profile-copy">
        <h1 id="profile-name">@Model.Personal["Name"]</h1>
        <p class="affiliation">@Model.Personal["Institute"]</p>
        <div class="prose biography">@Html.Raw(Model.BioHtmlString)</div>
        <div class="profile-links" aria-label="Contact and academic profiles">
            @if (!string.IsNullOrWhiteSpace(Model.Personal.GetValueOrDefault("Email")))
            {
                <a href="mailto:@Model.Personal["Email"]">Email <span aria-hidden="true">↗</span></a>
            }
            @foreach (var (label, url) in Model.Links)
            {
                if (!string.IsNullOrWhiteSpace(url))
                {
                    <a href="@url" target="_blank" rel="noopener noreferrer">@(label == "GoogleScholar" ? "Google Scholar" : label) <span aria-hidden="true">↗</span></a>
                }
            }
        </div>
    </div>

</section>
<section class="news-section" aria-labelledby="news-heading">
    <div class="section-heading">
        <h2 id="news-heading">News &amp; updates</h2>
        <a class="text-link" asp-page="/Research">View research <span aria-hidden="true">↗</span></a>
    </div>
    <div class="prose news-list">@Html.Raw(Model.NewsHtmlString)</div>
</section>
<section class="news-section acknowledgement-section" aria-labelledby="acknowledgement-heading">
    <div class="section-heading">
        <h2 id="acknowledgement-heading">Acknowledgement</h2>
    </div>
    <div class="prose acknowledgement-copy">@Html.Raw(Model.AcknowledgementHtmlString)</div>
</section>
