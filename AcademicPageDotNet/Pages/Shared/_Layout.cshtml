@inject IConfiguration Config
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Home";
    var siteTitle = Config["WebsiteTitle"];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101923" />
    <title>@(pageTitle == "Home" ? siteTitle : $"{pageTitle} — {siteTitle}")</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header shell">
        <a class="wordmark" asp-page="/Index">@siteTitle<span aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation">
            <a asp-page="/Index" aria-current="@(pageTitle == "Home" ? "page" : null)">Home</a>
            <a asp-page="/Research" aria-current="@(pageTitle == "Research" ? "page" : null)">Research</a>
        </nav>
    </header>
    <main id="main-content" class="shell" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer shell">
        <span>&copy; @DateTime.Now.Year @Config["Personal:Name"]</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
