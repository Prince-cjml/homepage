@page
@using AcademicPageDotNet.Models
@model AcademicPageDotNet.Pages.PublicationsModel
@{
    ViewData["Title"] = "Research";
}
<header class="page-heading">
    <p class="eyebrow">Research</p>
    <h1>Publications &amp; preprints<span class="accent">.</span></h1>
    <p class="author-legend">* Equal contribution <span aria-hidden="true">/</span> † Corresponding author</p>
</header>
@{
    void RenderPublication(PublicationItem publication)
    {
        <article class="publication @(publication.Highlight == true ? "publication-highlight" : "") @(string.IsNullOrWhiteSpace(publication.TeaserUrl) ? "publication-no-image" : "")">
            @if (!string.IsNullOrWhiteSpace(publication.TeaserUrl))
            {
                <div class="publication-image">
                    <img src="@publication.TeaserUrl" alt="Research illustration for @publication.Title" loading="lazy" width="640" height="400" />
                </div>
            }
            <div class="publication-copy">
                <p class="publication-venue">@(publication.Preprint == true ? "Preprint" : publication.PublicationName)
                    @if (publication.Highlight == true) { <span class="selected-label">Selected</span> }
                </p>
                <h3>@publication.Title</h3>
                <p class="authors">
                    @foreach (var author in Model.GetAuthorLabels(publication))
                    {
                        <span class="author">
                            @if ((author.Type & AuthorType.WebsiteOwner) != 0)
                            {
                                <strong>@author.Label</strong>
                            }
                            else if (string.IsNullOrWhiteSpace(author.Url))
                            {
                                @author.Label
                            }
                            else
                            {
                                <a href="@author.Url" target="_blank" rel="noopener noreferrer">@author.Label</a>
                            }
                            @if ((author.Type & AuthorType.FirstAuthor) != 0) { <sup>*</sup> }
                            @if ((author.Type & AuthorType.CorrespondingAuthor) != 0) { <sup>†</sup> }
                        </span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(publication.Introduction))
                {
                    <p class="publication-summary">@publication.Introduction</p>
                }
                <div class="publication-links" aria-label="Resources for @publication.Title">
                    @foreach (var link in Model.GetExternalLabels(publication))
                    {
                        if (!string.IsNullOrWhiteSpace(link.Url))
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Label <span aria-hidden="true">↗</span></a>
                        }
                    }
                </div>
            </div>
        </article>
    }
}
@if (Model.hasPreprint)
{
    <section class="publication-section" aria-labelledby="preprint-heading">
        <div class="section-heading"><h2 id="preprint-heading">Preprints <span class="count">@Model.preprintList.Count.ToString("D2")</span></h2></div>
        @foreach (var publication in Model.preprintList) { RenderPublication(publication); }
    </section>
}
@if (Model.hasPublication)
{
    <section class="publication-section" aria-labelledby="publication-heading">
        <div class="section-heading"><h2 id="publication-heading">Publications <span class="count">@Model.publicationList.Count.ToString("D2")</span></h2></div>
        @foreach (var publication in Model.publicationList) { RenderPublication(publication); }
    </section>
}
@if (!Model.hasPreprint && !Model.hasPublication)
{
    <p class="empty-state">Publications will be listed here as they become available.</p>
}
